# Base de datos PostgreSQL (Supabase, Neon, Railway, RDS... cualquiera vale)
DATABASE_URL="postgresql://user:password@localhost:5432/aparkeo"

# NextAuth
AUTH_SECRET="genera-uno-con: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Mapa (opcional: si no se define se usa OpenStreetMap gratuito vía Leaflet)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Feed oficial de plazas PMR del Concello de Vigo (mismo dataset que la app móvil)
PARKING_DATA_URL="https://datos.vigo.org/data/trafico/plazas_minusvalido.json"
