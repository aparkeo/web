# Ejemplo de variables de entorno para los tests E2E (Playwright).
# Copia a .env.test o exporta en la shell — NUNCA con valores reales en el repo.
# En la práctica, playwright.config.ts ya carga `.env` vía dotenv, así que
# DATABASE_URL suele venir de ahí.

# URL contra la que corren los E2E (opcional; default http://localhost:3000).
# No apuntar a producción: los E2E escriben datos de test en la BD.
E2E_BASE_URL=http://localhost:3000

# Necesaria SOLO para tests/e2e/report-consensus.spec.ts (creación de la plaza
# ficticia de test y limpieza obligatoria tras la ejecución). Si falta, ese
# spec se salta con test.skip y los smoke tests corren igual.
DATABASE_URL=postgresql://usuario:password@host:5432/base_de_datos
